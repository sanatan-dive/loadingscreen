# Image editing. Server-side only — never expose to the browser.
OPENROUTER_API_KEY=sk-or-v1-...

# Persistent cache, rate limits and spend ledger.
# Without these the app runs on an in-process store: fine locally, wrong on
# serverless (each instance gets its own counters).
SUPABASE_URL=https://navfmtgmjnntxctfnaqb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Hard spend cap. Fails closed.
DAILY_CEILING_USD=25
FREE_VIDEOS_PER_DAY=3
